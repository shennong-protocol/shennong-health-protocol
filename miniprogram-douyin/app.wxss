/**app.wxss**/
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 16px;
  color: #333;
  background-color: #F5F5F5;
  line-height: 1.6;
}

/* 全局颜色变量 */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn-primary {
  background: #2E7D32;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary:active {
  background: #1B5E20;
}

.btn-secondary {
  background: #fff;
  color: #2E7D32;
  border: 2rpx solid #2E7D32;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

/* 合规声明 */
.disclaimer {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 24rpx 0;
  line-height: 1.5;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 数字高亮 */
.number-highlight {
  font-size: 56rpx;
  font-weight: 700;
  color: #2E7D32;
}

/* 进度条 */
.progress-bar {
  height: 16rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #2E7D32);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 列表项 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.list-item:last-child {
  border-bottom: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

/* loading */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}
