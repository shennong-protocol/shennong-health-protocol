/* 舌诊页样式 */
.tongue-hero {
  text-align: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.hero-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.hero-or {
  font-size: 26rpx;
  color: #999;
  margin: 16rpx 0;
}

.constitution-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.constitution-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.constitution-name {
  font-size: 28rpx;
  color: #333;
}

.record-card {
  padding: 24rpx 32rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-confidence {
  font-size: 26rpx;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.record-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}
